HILE","    : 'while'","    ;","","XOR","    : 'xor'","    ;","","// Operators and punctuation","BANG_EQ_EQ","    : '!=='","    ;","","COLON_COLON_GT","    : '::\u003e'","    ;","","COLON_GT_GT","    : ':\u003e\u003e'","    ;","","EQ_EQ_EQ","    : '==='","    ;","","BANG_EQ","    : '!='","    ;","","STAR_STAR","    : '**'","    ;","","ARROW","    : '-\u003e'","    ;","","DOT_DOT","    : '..'","    ;","","DOT_QUESTION","    : '.?'","    ;","","COLON_COLON","    : '::'","    ;","","COLON_EQ","    : ':='","    ;","","COLON_GT","    : ':\u003e'","    ;","","LE","    : '\u003c='","    ;","","EQ_EQ","    : '=='","    ;","","FAT_ARROW","    : '=\u003e'","    ;","","GE","    : '\u003e='","    ;","","QUESTION_QUESTION","    : '??'","    ;","","AT_AT","    : '@@'","    ;","","HASH","    : '#'","    ;","","DOLLAR","    : '$'","    ;","","PERCENT","    : '%'","    ;","","AMP","    : '\u0026'","    ;","","LPAREN","    : '('","    ;","","RPAREN","    : ')'","    ;","","STAR","    : '*'","    ;","","PLUS","    : '+'","    ;","","COMMA","    : ','","    ;","","MINUS","    : '-'","    ;","","DOT","    : '.'","    ;","","SLASH","    : '/'","    ;","","COLON","    : ':'","    ;","","SEMI","    : ';'","    ;","","LT","    : '\u003c'","    ;","","EQ","    : '='","    ;","","GT","    : '\u003e'","    ;","","QUESTION","    : '?'","    ;","","AT_SIGN","    : '@'","    ;","","LBRACK","    : '['","    ;","","RBRACK","    : ']'","    ;","","CARET","    : '^'","    ;","","LBRACE","    : '{'","    ;","","PIPE","    : '|'","    ;","","RBRACE","    : '}'","    ;","","TILDE","    : '~'","    ;","","// Identifiers","IDENTIFIER","    : [a-zA-Z_] [a-zA-Z0-9_]*","    ;","","// String literals","STRING","    : '\\'' ('\\\\' . | ~['\\\\])* '\\''","    ;","","DOUBLE_STRING","    : '\"' ('\\\\' . | ~[\"\\\\])* '\"'","    ;","","// Numeric literals","INTEGER","    : [0-9]+","    ;","","REAL","    : [0-9]* '.' [0-9]+ ([eE] [+-]? [0-9]+)?","    | [0-9]+ [eE] [+-]? [0-9]+","    ;","","// Comments","// REGULAR_
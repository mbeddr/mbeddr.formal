        </node>
        <node concept="8EhU9" id="4QEfSMD5voI" role="66U86">
          <property role="TrG5h" value="best" />
          <node concept="8EhVB" id="4QEfSMD5voJ" role="8EhU5">
            <property role="8EhVw" value="ScalarValue" />
          </node>
          <node concept="3HG_t4" id="4QEfSMD5voK" role="8EhU4">
            <property role="3HG_t5" value="Out of the evaluation results of all the given alternatives, the one that is considered&#10;&quot;best&quot;, in the sense that it is the value the selectedAlternative should have. This&#10;value must be computed in any concrete specialization of TradeStudyObjective." />
          </node>
        </node>
        <node concept="3TIFEV" id="4QEfSMD5voL" role="66U86">
          <node concept="3bnkR8" id="4QEfSMD5voM" role="SPUDi">
            <property role="3bnkR9" value="eval(selectedAlternative) == best" />
          </node>
        </node>
      </node>
      <node concept="66VRr" id="4QEfSMD5voN" role="3Z9vGx">
        <property role="TrG5h" value="MinimizeObjective" />
        <node concept="35c6Ng" id="4QEfSMD5voO" role="66U85">
          <property role="35c6Nm" value="TradeStudyObjective" />
          <ref role="35c6Nn" node="4QEfSMD5vow" resolve="TradeStudyObjective" />
        </node>
        <node concept="3HG_t4" id="4QEfSMD5voP" role="66U86">
          <property role="3HG_t5" value="A MinimizeObjective is a TradeStudyObjective that requires that the&#10;selectedAlternative have the minimum ObjectiveFunction value of all the&#10;given alternatives." />
        </node>
        <node concept="8EhU9" id="4QEfSMD5voQ" role="66U86">
          <node concept="3wdj9f" id="4QEfSMD5voR" role="3wdj9d">

          <ref role="3wdj98" node="4QEfSMD5$or" resolve="scalarQuantities" />
        </node>
        <node concept="8EhVB" id="4QEfSMD5wPw" role="8EhU5">
          <property role="8EhVw" value="DarcyFrictionFactorValue" />
          <ref role="8EhVx" node="4QEfSMD5wPr" resolve="DarcyFrictionFactorValue" />
        </node>
      </node>
      <node concept="1AcQlj" id="4QEfSMD5wPx" role="3Z9vGx">

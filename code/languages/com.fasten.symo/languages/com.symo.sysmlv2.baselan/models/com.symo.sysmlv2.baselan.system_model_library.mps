        </node>
        <node concept="8EhVB" id="4QEfSMD5wUD" role="8EhU5">
          <property role="8EhVw" value="GraetzNumberForMassTransferValue" />
          <ref role="8EhVx" node="4QEfSMD5wU$" resolve="GraetzNumberForMassTransferValue" />

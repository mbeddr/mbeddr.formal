          <node concept="3HG_t4" id="4QEfSMD5voD" role="6al$D">
            <property role="3HG_t5" value="The alternatives being considered in the TradeStudy for which this TradeStudyObjective&#10;is the objective." />
          </node>
        </node>
        <node concept="SPUE$" id="4QEfSMD5voE" role="66U86">
          <property role="TrG5h" value="eval" />
          <node concept="3xZtmk" id="4QEfSMD5voF" role="SPUEB" />
          <node concept="35c6Ng" id="4QEfSMD5voG" role="SPUDr">

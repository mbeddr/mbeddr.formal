      <node concept="8EhU9" id="4QEfSMD5$SI" role="3Z9vGx">
        <property role="6zCXJ" value="UTC" />
        <property role="TrG5h" value="'Coordinated Universal Time'" />
        <node concept="8EhVB" id="4QEfSMD5$SJ" role="8EhU5">

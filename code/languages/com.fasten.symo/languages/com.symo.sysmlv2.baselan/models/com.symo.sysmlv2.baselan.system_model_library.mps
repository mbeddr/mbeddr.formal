          <property role="3wdj9b" value="scalarQuantities" />
          <ref role="3wdj98" node="4QEfSMD5$or" resolve="scalarQuantities" />
        </node>
        <node concept="8EhVB" id="4QEfSMD5wVE" role="8EhU5">
          <property role="8EhVw" value="LockhartMartinelliParameterValue" />
          <ref role="8EhVx" node="4QEfSMD5wV_" resolve="LockhartMartinelliParameterValue" />

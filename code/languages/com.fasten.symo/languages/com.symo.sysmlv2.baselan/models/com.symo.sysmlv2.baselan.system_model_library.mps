          <ref role="3wdj98" node="4QEfSMD5$or" resolve="scalarQuantities" />
        </node>
        <node concept="8EhVB" id="4QEfSMD5wVL" role="8EhU5">
          <property role="8EhVw" value="BejanNumberForMassTransferValue" />
          <ref role="8EhVx" node="4QEfSMD5wVG" resolve="BejanNumberForMassTransferValue" />
        </node>
      </node>

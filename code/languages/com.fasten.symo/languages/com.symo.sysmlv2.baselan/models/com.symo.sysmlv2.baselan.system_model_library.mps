      <node concept="8EhVW" id="4QEfSMD5wGR" role="3Z9vGx">
        <property role="TrG5h" value="MassEnergyTransferCoefficientValue" />
        <node concept="8EhVB" id="4QEfSMD5wGS" role="3xKGGC">
          <property role="8EhVw" value="ScalarQuantityValue" />
          <ref role="8EhVx" node="4QEfSMD5$od" resolve="ScalarQuantityValue" />

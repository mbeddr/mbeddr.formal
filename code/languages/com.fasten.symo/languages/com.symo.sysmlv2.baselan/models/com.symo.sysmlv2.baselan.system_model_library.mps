          <property role="3wdj9b" value="scalarQuantities" />
          <ref role="3wdj98" node="4QEfSMD5$or" resolve="scalarQuantities" />
        </node>
        <node concept="8EhVB" id="4QEfSMD5wPK" role="8EhU5">
          <property role="8EhVw" value="GoertlerNumberValue" />
          <ref role="8EhVx" node="4QEfSMD5wPF" resolve="GoertlerNumberValue" />
        </node>
      </node>
      <node concept="1AcQlj" id="4QEfSMD5wPL" role="3Z9vGx">
        <property role="TrG5h" value="goertlerParameter" />
        <node concept="1Bo4sc" id="4QEfSMD5wPM" role="1BST0Y">
          <property role="1Bo4sf" value="goertlerNumber" />
          <ref role="1Bo4se" node="4QEfSMD5wPI" resolve="goertlerNumber" />

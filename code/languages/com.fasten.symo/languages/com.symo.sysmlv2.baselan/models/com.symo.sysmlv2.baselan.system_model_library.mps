          <property role="8EhVk" value="*" />
        </node>
        <node concept="3HG_t4" id="4QEfSMD5_m1" role="SPUDs">
          <property role="3HG_t5" value="originalRequirements are the original requirements in Derivation connections." />
        </node>
      </node>
      <node concept="SPUEH" id="4QEfSMD5_m2" role="3Z9vGx">
        <property role="TrG5h" value="derivedRequirements" />
        <node concept="8EhVq" id="4QEfSMD5_m3" role="SPUDq">
          <property role="8EhVr" value="*" />
          <property role="8EhVk" value="*" />
        </node>
        <node concept="3HG_t4" id="4QEfSMD5_m4" role="SPUDs">
          <property role="3HG_t5" value="derivedRequirements are the derived requirments in Derivation connections." />
        </node>
      </node>
      <node concept="2uUmlJ" id="4QEfSMD5_m5" role="3Z9vGx">
        <property role="TrG5h" value="Derivation" />
        <property role="3eyS6o" value="true" />
        <node concept="3HG_t4" id="4QEfSMD5_m6" role="3w00ZY">
          <property role="3HG_t5" value="A Derivation connection asserts that one or more derivedRequirements are derived from&#10;a single originalRequirement. This means that any subject that satisfies the&#10;originalRequirement should, in itself or though other things related to it, satisfy&#10;each of the derivedRequirements.&#10;&#10;A connection usage typed by Derivation must have requirement usages for all its ends.&#10;The single end for the originalRequirement should subset originalRequirement, while&#10;the rest of the ends should subset derivedRequirements." />
        </node>
        <node concept="SPUEH" id="4QEfSMD5_m7" role="3w00ZY">
          <property role="TrG5h" value="originalRequirement" />
          <property role="35c6MN" value="true" />
          <node concept="3wdj9f" id="4QEfSMD5_m8" role="3wdj9c">
            <property role="3wdj9b" value="participant" />
          </node>
          <node concept="3wdj9f" id="4QEfSMD5_m9" role="3wdj9d">
            <property role="3wdj9b" value="originalRequirements" />
          </node>
          <node concept="8EhVq" id="4QEfSMD5_ma" role="SPUDq">
            <property role="8EhVr" value="1" />
            <property role="8EhVk" value="1" />
          </node>
          <node concept="3HG_t4" id="4QEfSMD5_mb" role="SPUDs">
            <property role="3HG_t5" value="The single original requirement." />
          </node>
        </node>
        <node concept="SPUEH" id="4QEfSMD5_mc" role="3w00ZY">
          <property role="35c6MN" value="true" />
          <node concept="3wdj9f" id="4QEfSMD5_md" role="3wdj9c">
            <property role="3wdj9b" value="participant" />
          </node>
          <node concept="3wdj9f" id="4QEfSMD5_me" role="3wdj9d">
            <property role="3wdj9b" value="derivedRequirements" />
          </node>
          <node concept="8EhVq" id="4QEfSMD5_mf" role="SPUDq">
            <property role="8EhVr" value="1" />
            <property role="8EhVk" value="*" />
          </node>
          <node concept="3HG_t4" id="4QEfSMD5_mg" role="SPUDs">
            <property role="3HG_t5" value="The one or more requirements that are derived from the original requirement." />
          </node>
        </node>
        <node concept="SPUEA" id="4QEfSMD5_mh" role="3w00ZY">
          <property role="TrG5h" value="originalNotDerived" />
          <property role="3815tZ" value="6jJ9KHVIUlW/private" />
          <node concept="3HG_t4" id="4QEfSMD5_mi" role="SPUDs">
            <property role="3HG_t5" value="The original requirement must not be a derived requirement." />
          </node>
          <node concept="3bnkR8" id="4QEfSMD5_mj" role="SPUDi">
            <property role="3bnkR9" value="derivedRequirements-&gt;excludes(originalRequirement)" />
          </node>
        </node>
        <node concept="SPUEA" id="4QEfSMD5_mk" role="3w00ZY">
          <property role="TrG5h" value="originalImpliesDerived" />
          <property role="3815tZ" value="6jJ9KHVIUlW/private" />
          <node concept="3HG_t4" id="4QEfSMD5_ml" role="SPUDs">
            <property role="3HG_t5" value="Whenever the originalRequirement is satisfied, all of the derivedRequirements must also&#10;be satisfied." />
          </node>
          <node concept="3bnkR8" id="4QEfSMD5_mm" role="SPUDi">
            <property role="3bnkR9" value="originalRequirement.result implies allTrue(derivedRequirements.result)" />
          </node>
        </node>
      </node>
      <node concept="2uUmlE" id="4QEfSMD5_mn" role="3Z9vGx">
        <property role="3eyS6o" value="true" />
        <property role="2uUmlw" value="true" />

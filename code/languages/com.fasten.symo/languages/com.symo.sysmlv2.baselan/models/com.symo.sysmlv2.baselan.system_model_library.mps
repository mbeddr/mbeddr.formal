        <property role="TrG5h" value="suratmanNumber" />
        <node concept="1Bo4sc" id="4QEfSMD5wRa" role="1BST0Y">
          <property role="1Bo4sf" value="laplaceNumber" />
          <ref role="1Bo4se" node="4QEfSMD5wR6" resolve="laplaceNumber" />
        </node>
      </node>
      <node concept="1_pRso" id="4QEfSMD5wRb" role="3Z9vGx">
        <property role="1_pRss" value="ISO-80000-11 item 11-4.38 Blake number" />
        <property role="1_pRsu" value="true" />
      </node>
      <node concept="8EhVW" id="4QEfSMD5wRc" role="3Z9vGx">
        <property role="TrG5h" value="BlakeNumberValue" />
        <node concept="8EhVB" id="4QEfSMD5wRd" role="3xKGGC">
          <property role="8EhVw" value="DimensionOneValue" />
          <ref role="8EhVx" node="4QEfSMD5$mH" resolve="DimensionOneValue" />
        </node>
        <node concept="3HG_t4" id="4QEfSMD5wRe" role="8EhVZ">
          <property role="3HG_t5" value="source: item 11-4.38 Blake number&#10;symbol(s): `Bl`&#10;application domain: generic&#10;name: BlakeNumber (specializes DimensionOneQuantity)&#10;quantity dimension: 1&#10;measurement unit(s): 1&#10;tensor order: 0&#10;definition: relation between inertial forces and viscous forces in a porous material, expressed by `Bl = (v*ρ*l)/(η*(1-ε))`, where `v` is speed (ISO 80000-3) of the fluid, `ρ` is mass density (ISO 80000-4) of the fluid, `l` is characteristic length (ISO 80000-3) defined as the volume of a particle divided by its surface area, `η` is dynamic viscosity (ISO 80000-4) of the fluid, and `ε` is porosity of the material (=void fraction)&#10;remarks: The Blake number can be interpreted as a Reynolds number for flow in porous material." />
        </node>
      </node>
      <node concept="8EhU9" id="4QEfSMD5wRf" role="3Z9vGx">
        <property role="TrG5h" value="blakeNumber" />

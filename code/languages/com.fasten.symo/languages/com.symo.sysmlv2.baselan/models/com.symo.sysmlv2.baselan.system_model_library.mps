          <node concept="3HG_t4" id="4QEfSMD5vp4" role="6al$D">
            <property role="3HG_t5" value="The set of alternatives being considered in this TradeStudy.&#10;&#10;In a TradeStudy usage, bind this feature to the actual collection of&#10;alternatives to be considered." />
          </node>
        </node>

            <ref role="3wdj98" node="4QEfSMD5voI" resolve="best" />
          </node>
          <node concept="3bnkR8" id="4QEfSMD5voY" role="2gbwqI">
            <property role="3bnkR9" value="alternatives-&gt;maximize {&#10;&#9;&#9;&#9;doc&#10;&#9;&#9;&#9;/*&#10;&#9;&#9;&#9; * For a MinimizeObjective, the best value is the maximum one.&#10;&#9;&#9;&#9; */&#10;&#9;&#9;&#10;&#9;&#9;&#9;in x; eval(x)&#10;&#9;&#9;}" />
          </node>
        </node>
      </node>
      <node concept="66VRU" id="4QEfSMD5voZ" role="3Z9vGx">
        <property role="TrG5h" value="TradeStudy" />
        <property role="3eyS6o" value="true" />
        <node concept="3HG_t4" id="4QEfSMD5vp0" role="66U86">
          <property role="3HG_t5" value="A TradeStudy is an analysis case whose subject is a set of alternatives&#10;(at least one) and whose result is a selection of one of those alternatives.&#10;The alternatives are evaluated based on a given ObjectiveFunction and the&#10;selection is made such that it satisfies the objective of the TradeStudy&#10;(which must be a TradeStudyObjective)." />
        </node>
        <node concept="38pZY" id="4QEfSMD5vp1" role="66U86">
          <property role="TrG5h" value="studyAlternatives" />

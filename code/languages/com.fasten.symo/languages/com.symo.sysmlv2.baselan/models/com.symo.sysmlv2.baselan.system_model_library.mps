        </node>
        <node concept="3HG_t4" id="4QEfSMD5vkG" role="8EhVZ">
          <property role="3HG_t5" value="SamplePair is a key-value pair of a domain-value and a range-value, used as a sample element in SampledFunction." />
        </node>
        <node concept="8EhU9" id="4QEfSMD5vkH" role="8EhVZ">
          <property role="TrG5h" value="domainValue" />
          <node concept="3wdj9f" id="4QEfSMD5vkI" role="3wdj9d">

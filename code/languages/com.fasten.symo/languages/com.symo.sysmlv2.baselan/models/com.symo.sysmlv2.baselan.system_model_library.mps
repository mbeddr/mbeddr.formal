            <ref role="3wdj98" node="4QEfSMD5voI" resolve="best" />
          </node>
          <node concept="3bnkR8" id="4QEfSMD5voS" role="2gbwqI">
            <property role="3bnkR9" value="alternatives-&gt;minimize {&#10;&#9;&#9;&#9;doc&#10;&#9;&#9;&#9;/*&#10;&#9;&#9;&#9; * For a MinimizeObjective, the best value is the minimum one.&#10;&#9;&#9;&#9; */&#10;&#9;&#9;&#10;&#9;&#9;&#9;in x; eval(x)&#10;&#9;&#9;}" />
          </node>
        </node>
      </node>

          <node concept="3HG_t4" id="4QEfSMD5vp7" role="SPUDs">
            <property role="3HG_t5" value="The EvaluationFunction to be used to evaluate the alternatives.&#10;&#10;In a TradeStudy usage, redefine this feature to provide the desired&#10;calculation (or bind it to a calculation usage that does so)." />
          </node>
        </node>
        <node concept="38pZS" id="4QEfSMD5vp8" role="66U86">
          <property role="TrG5h" value="tradeStudyObjective" />
          <node concept="35c6Ng" id="4QEfSMD5vp9" role="SPUDr">

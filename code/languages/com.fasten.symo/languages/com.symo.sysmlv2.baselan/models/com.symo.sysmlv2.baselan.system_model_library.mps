        </node>
        <node concept="3HG_t4" id="4QEfSMD5voV" role="66U86">
          <property role="3HG_t5" value="A MaximizeObjective is a TradeStudyObjective that requires that the&#10;selectedAlternative have the maximum ObjectiveFunction value of all the&#10;given alternatives." />
        </node>
        <node concept="8EhU9" id="4QEfSMD5voW" role="66U86">
          <node concept="3wdj9f" id="4QEfSMD5voX" role="3wdj9d">

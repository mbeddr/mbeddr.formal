          <ref role="3wdj98" node="4QEfSMD5$or" resolve="scalarQuantities" />
        </node>
        <node concept="8EhVB" id="4QEfSMD5wVs" role="8EhU5">
          <property role="8EhVw" value="ExpansionNumberValue" />
          <ref role="8EhVx" node="4QEfSMD5wVn" resolve="ExpansionNumberValue" />

      <node concept="66VRr" id="4QEfSMD5vow" role="3Z9vGx">
        <property role="TrG5h" value="TradeStudyObjective" />
        <property role="3eyS6o" value="true" />
        <node concept="3HG_t4" id="4QEfSMD5vox" role="66U86">
          <property role="3HG_t5" value="A TradeStudyObjective is the base definition for the objective of a TradeStudy.&#10;The requirement is to choose from a given set of alternatives the selectedAlternative&#10;for that has the best evaluation according to a given EvaluationFunction. What&#10;value is considered &quot;best&quot; is not defined in the abstract base definition but must be&#10;computed in any concrete specialization." />
        </node>
        <node concept="38pZY" id="4QEfSMD5voy" role="66U86">
          <property role="TrG5h" value="selectedAlternative" />
          <node concept="35c6Ng" id="4QEfSMD5voz" role="35c6Nl">
            <property role="35c6Nm" value="Anything" />
          </node>
          <node concept="3HG_t4" id="4QEfSMD5vo$" role="6al$D">
            <property role="3HG_t5" value="The alternative that should be selected, as evaluated using the given&#10;ObjectiveFunction." />
          </node>
        </node>
        <node concept="35c6Nh" id="4QEfSMD5vo_" role="66U86">
          <property role="TrG5h" value="alternatives" />
